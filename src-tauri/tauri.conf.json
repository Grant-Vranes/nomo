{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nomo",
  "version": "0.6.2",
  "identifier": "com.nomo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nomo",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        },
        "hiddenTitle": true,
        "backgroundThrottling": "disabled",
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["**/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../sample.md": "samples/sample.md",
      "../assets/128x128.png": "samples/assets/128x128.png",
      "../resources/drawio": "resources/drawio",
      "../resources/excalidraw": "resources/excalidraw"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["txt"],
        "name": "Text Document",
        "description": "Text Document",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": ["json"],
        "name": "JSON Document",
        "description": "JSON Document",
        "role": "Editor",
        "mimeType": "application/json"
      },
      {
        "ext": ["html", "htm"],
        "name": "HTML Document",
        "description": "HTML Document",
        "role": "Viewer",
        "mimeType": "text/html"
      },
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": ["png", "jpg", "jpeg", "gif", "webp", "svg", "bmp", "ico", "avif"],
        "name": "Image File",
        "description": "Image File",
        "role": "Viewer",
        "mimeType": "image/*"
      },
      {
        "ext": ["drawio"],
        "name": "Draw.io Diagram",
        "description": "Draw.io Diagram",
        "role": "Editor",
        "mimeType": "application/x-drawio"
      },
      {
        "ext": ["excalidraw"],
        "name": "Excalidraw Drawing",
        "description": "Excalidraw Drawing",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "bundleVersion": "3020"
    }
  }
}
